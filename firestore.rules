rules_version = '2';

// Regras de segurança do Gordinho Burguer.
// Troque o e-mail abaixo pelo(s) e-mail(s) da equipe que vai usar o painel.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['EMAIL_DA_LOJA@gmail.com'];
    }

    // Cardápio e funcionamento: todo mundo lê, só a equipe altera
    match /config/store { allow read: if true; allow write: if isStaff(); }
    match /categories/{id} { allow read: if true; allow write: if isStaff(); }
    match /products/{id} { allow read: if true; allow write: if isStaff(); }

    // Numeração dos pedidos: cliente só pode somar 1
    match /config/counter {
      allow read: if true;
      allow create: if isStaff() || request.resource.data.n == 1;
      allow update: if isStaff() || request.resource.data.n == resource.data.n + 1;
    }

    // Pedidos: cliente cria e acompanha o próprio (pelo código secreto do pedido);
    // só a equipe lista, altera ou apaga.
    match /orders/{id} {
      allow get: if true;
      allow list, update, delete: if isStaff();
      allow create: if request.resource.data.status == 'novo'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.customer.nome is string
        && request.resource.data.customer.nome.size() <= 80
        && request.resource.data.subtotal is number;
    }
  }
}
